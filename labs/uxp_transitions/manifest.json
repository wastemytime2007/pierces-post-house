{
  "id": "com.posthouse.transitionlab",
  "name": "Post House Transition Lab",
  "version": "0.4.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.6.0"
    }
  ],
  "manifestVersion": 5,
  "requiredPermissions": {},
  "entrypoints": [
    {
      "type": "panel",
      "id": "transitionlab",
      "minimumSize": { "width": 360, "height": 420 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 420, "height": 600 },
      "preferredFloatingSize": { "width": 460, "height": 640 },
      "label": { "default": "Transition Lab" }
    }
  ]
}
