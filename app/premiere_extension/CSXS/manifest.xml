<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  ExtensionBundleId="com.posthouse.interpret"
  ExtensionBundleVersion="0.1.0"
  Version="7.0">

  <!--
    Post House B-Roll Interpreter — a narrow companion extension, NOT a
    rebuild of PreCut's export pipeline. FCP7 XML (the app's own delivery
    path) already creates a second, clearly-labeled Project-panel entry
    for every B-roll clip that needs a frame-rate conform (e.g.
    "DJI_0002 [INTERPRET TO 29.970fps]"). Premiere's own Interpret
    Footage state cannot be expressed in that XML (confirmed by real
    testing — see ROADMAP.md Decision Log, 2026-09-03), so this
    extension's only job is applying it automatically once the XML has
    been imported: it scans the Project panel for that naming pattern
    and calls Interpret Footage on each match. Everything else (bins,
    import, sequences, clip placement) stays in the XML — this does not
    reimplement any of that.
  -->

  <ExtensionList>
    <Extension Id="com.posthouse.interpret.panel" Version="0.1.0"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <!-- Covers Premiere Pro 2019 through 2025+ -->
      <Host Name="PPRO" Version="[13.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.posthouse.interpret.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
        </Resources>
        <Lifecycle>
          <!--
            No manual open, ever: AutoVisible=false plus StartOn means
            Premiere loads and starts running this extension's index.html
            the moment it launches (ApplicationActivate), with no window,
            no menu entry, nothing for Ryan to click. See
            posthouse_interpreter.log (written by jsx/host.jsx) for
            what it's doing, since there's no panel to watch anymore.
          -->
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry>
            <Size>
              <Height>1</Height>
              <Width>1</Width>
            </Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>

</ExtensionManifest>
