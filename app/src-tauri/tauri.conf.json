{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Post House",
  "version": "1.0.0-beta.3",
  "identifier": "com.pierce.posthouse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Post House",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Visible",
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["/Volumes/**", "$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": [
      "../python_backend/**/*.py",
      "../python_backend/**/*.png",
      "../python_backend/requirements.txt",
      "../premiere_extension/**/*.xml",
      "../premiere_extension/**/*.html",
      "../premiere_extension/**/*.js",
      "../premiere_extension/**/*.jsx"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Video",
    "shortDescription": "B-Roll indexer and auto-editor for Premiere Pro",
    "longDescription": "Drag footage in, get auto-assembled Premiere sequences out. Uses local CLIP embeddings, Whisper transcription, and Claude for creative direction.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": null
    }
  }
}
